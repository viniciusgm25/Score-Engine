# Porta do Score Engine
SCORE_PORT=8080

# Banco de dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/score_engine_db
DB_USERNAME=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui

# Integração com o microsserviço de Decisão
# Se estiver na mesma máquina, mantenha localhost; senão, use o IP da máquina da Decisão
DECISION_URL=http://localhost:8081
DECISION_ENABLED=true

# Segurança (JWT)
JWT_ENABLED=false
JWT_ISSUER_URI=http://localhost:8081/auth/realms/score-realm

# CORS
# Origens extras permitidas, separadas por vírgula
CORS_ALLOWED_ORIGINS=https://seu-site-aqui.com
CORS_ALLOW_LOCAL_NETWORK=true
